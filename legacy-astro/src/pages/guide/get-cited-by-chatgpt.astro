const faq = [
  {
    q: "Does ChatGPT crawl my site directly?",
    a: "Two things happen. (1) OpenAI trains models on a crawled web snapshot (their crawler is GPTBot). Training cutoffs are historical, so new sites often miss them. (2) ChatGPT with Search / ChatGPT-User / SearchGPT performs <em>live retrieval</em> via Bing at query time. That live retrieval is how new brands get cited — you don't need to wait for the next training cycle.",
  },
  {
    q: "What user agents should I allow in robots.txt?",
    a: "For OpenAI specifically: <code>GPTBot</code> (training crawler), <code>ChatGPT-User</code> (in-chat browsing), <code>OAI-SearchBot</code> (SearchGPT). Default allow all three. If you block <code>GPTBot</code> you'll be excluded from future training but not from live retrieval; if you block <code>ChatGPT-User</code> or <code>OAI-SearchBot</code> you're invisible to the live path too.",
  },
  {
    q: "Does ChatGPT cite me if I pay for ads?",
    a: "No. ChatGPT has no ads product that affects citations (as of 2026). Citations are based on retrieval quality and content, not spend. This is one reason AEO is a leveler — a bootstrapped brand can outrank a well-funded competitor if the content and entity signals are better.",
  },
  {
    q: "How often does ChatGPT re-evaluate brands?",
    a: "Training cycle: months. Live retrieval: every query. So if you fix your site today, ChatGPT's Search feature can cite you tomorrow. But the 'what ChatGPT knows without searching' cache updates only with new model releases.",
  },
  {
    q: "Why does ChatGPT sometimes name competitors but not me?",
    a: "Three common reasons: (1) weak brand entity — ChatGPT doesn't confidently know who you are; (2) your content isn't retrieval-optimized — when it does search, it gets competitors' pages; (3) competitors are mentioned in authoritative third-party sources (reviews, comparison blogs) that ChatGPT has high trust in.",
  },
];
