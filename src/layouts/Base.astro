---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: 'en' | 'zh';
}

const {
  ogImage = '/og.png',
  noindex = false,
  lang = 'en',
} = Astro.props;

// Defaults vary per language
const DEFAULTS = {
  en: {
    title: 'Citebeam — AI brand visibility, by bbd.sh studio',
    description: "bbd.sh is a builder studio that incubates digital products with founders and VCs — validate the business, then ship it. Citebeam is one of our service lines: we make your brand show up when customers ask ChatGPT, Claude, or Doubao for a recommendation. Audit, fix, monitor.",
    htmlLang: 'en',
  },
  zh: {
    title: 'Citebeam · 让 AI 搜索推荐你的品牌 | bbd.sh 孵化工坊',
    description: 'bbd.sh 是陪创始人和 VC 把 idea 孵化落地的 builder studio —— 先验证商业模式，再把产品 ship 出来。Citebeam 是我们的其中一条服务线：让你的品牌在客户问 ChatGPT、Claude、豆包、Kimi、通义时被推荐。审计、修复、持续监测。',
    htmlLang: 'zh-Hans',
  },
};

const title = Astro.props.title ?? DEFAULTS[lang].title;
const description = Astro.props.description ?? DEFAULTS[lang].description;
const htmlLang = DEFAULTS[lang].htmlLang;

// Compute hreflang alternates
// /xxx  → ZH: /zh/xxx
// /zh/xxx → EN: /xxx
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
let enPath: string;
let zhPath: string;
if (path.startsWith('/zh/') || path === '/zh') {
  enPath = path === '/zh' ? '/' : path.replace(/^\/zh/, '');
  zhPath = path;
} else {
  enPath = path;
  zhPath = path === '/' ? '/zh/' : `/zh${path}`;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const enURL = new URL(enPath, Astro.site).toString();
const zhURL = new URL(zhPath, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Language alternates (hreflang) -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="zh-Hans" href={zhURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Search engine verifications -->
    <meta name="google-site-verification" content="d0yVMkQ8JkZyNRHmKlJpSo1KhnevXdLDlTAGMsVTHwM" />
    <meta name="msvalidate.01" content="E15215E93FCC2A42B5EA3FA9B8A51B80" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Citebeam" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {lang === 'en' && <meta property="og:locale:alternate" content="zh_CN" />}
    {lang === 'zh' && <meta property="og:locale:alternate" content="en_US" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://bbd.sh/#org',
          name: 'bbd.sh',
          alternateName: ['bbd.sh studio', 'bbd builder studio', 'bbd 孵化工坊'],
          url: 'https://bbd.sh',
          description: "bbd.sh is a builder studio that incubates digital products with founders and VCs. End-to-end: validate business model, design brand, build full-stack product, ship and grow.",
          sameAs: [
            'https://github.com/bbd-sh',
            'https://x.com/bbd_sh',
            'https://www.linkedin.com/company/bbd-sh',
          ],
          makesOffer: [
            { '@id': 'https://citebeam.bbd.sh/#service' },
          ],
        },
        {
          '@type': 'Service',
          '@id': 'https://citebeam.bbd.sh/#service',
          name: 'Citebeam',
          alternateName: ['Citebeam AEO', 'bbd.sh Citebeam', 'AI 品牌可见度服务', 'AEO 服务'],
          serviceType: 'Answer Engine Optimization (AEO)',
          description: "Citebeam is one of bbd.sh's service lines. When customers ask ChatGPT, Claude, Perplexity, Doubao, Kimi, or Tongyi for a recommendation, Citebeam makes sure the brand shows up. Audit current AI visibility, fix the gaps, and monitor ongoing.",
          provider: { '@id': 'https://bbd.sh/#org' },
          isRelatedTo: {
            '@type': 'Service',
            name: 'Full-stack product incubation by bbd.sh',
            url: 'https://bbd.sh/work',
          },
          areaServed: 'Global',
          url: 'https://citebeam.bbd.sh',
          audience: {
            '@type': 'Audience',
            audienceType: 'ecommerce brands, SaaS companies, VC portfolio companies, operators',
          },
          availableLanguage: ['en', 'zh-Hans'],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://citebeam.bbd.sh/#website',
          url: 'https://citebeam.bbd.sh',
          name: 'Citebeam',
          publisher: { '@id': 'https://bbd.sh/#org' },
          inLanguage: ['en', 'zh-Hans'],
          about: { '@id': 'https://citebeam.bbd.sh/#service' },
        },
      ],
    })}></script>
  </head>
  <body class={`min-h-screen flex flex-col ${lang === 'zh' ? 'font-cn' : ''}`}>
    <slot />
  </body>
</html>
