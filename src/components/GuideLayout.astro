---
import Base from '../layouts/Base.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: 'en' | 'zh';
  title: string;
  description: string;
  h1: string;
  lead: string;
  faq?: { q: string; a: string }[];
  updatedAt?: string;  // ISO date, e.g. "2026-04-20"
}
const { lang, title, description, h1, lead, faq = [], updatedAt = '2026-04-20' } = Astro.props;

// Build FAQPage schema if FAQ items provided
const faqSchema = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const labels = {
  en: {
    updated: 'Updated',
    faqTitle: 'FAQ',
    backHome: '← back to Citebeam',
    ctaTitle: 'Ready to run Citebeam on your brand?',
    ctaLabel: 'Start an engagement',
    also: 'Read also',
  },
  zh: {
    updated: '更新于',
    faqTitle: '常见问题',
    backHome: '← 返回 Citebeam 首页',
    ctaTitle: '给你的品牌跑一次 Citebeam？',
    ctaLabel: '开始接触',
    also: '延伸阅读',
  },
}[lang];

const homeHref = lang === 'zh' ? '/zh/' : '/';
---

<Base lang={lang} title={title} description={description}>
  <LangSwitcher current={lang} />

  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  )}

  <article class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <p class="font-mono text-xs uppercase tracking-widest text-muted mb-6">
      <a href={homeHref} class="hover:text-electric">{labels.backHome}</a>
      <span class="mx-2">/</span>
      <span>guide</span>
    </p>

    <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">
      {h1}
    </h1>

    <p class="text-lg text-ink/70 leading-relaxed mb-12 border-l-4 border-electric pl-4">
      {lead}
    </p>

    <div class="prose prose-lg max-w-none text-ink/85 leading-relaxed
                prose-headings:font-display prose-headings:font-bold
                prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6
                prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4
                prose-a:text-electric prose-a:no-underline hover:prose-a:underline
                prose-strong:text-ink
                prose-code:bg-ink/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </div>

    {faq.length > 0 && (
      <section class="mt-20 border-t border-ink/10 pt-12">
        <h2 class="font-display text-3xl font-bold mb-8">{labels.faqTitle}</h2>
        <div class="space-y-6">
          {faq.map((item) => (
            <details class="border border-ink/10 p-5 group">
              <summary class="font-bold cursor-pointer text-ink group-open:text-electric">
                {item.q}
              </summary>
              <p class="mt-3 text-ink/75 leading-relaxed" set:html={item.a} />
            </details>
          ))}
        </div>
      </section>
    )}

    <footer class="mt-20 border-t border-ink/10 pt-8 font-mono text-xs text-muted flex flex-wrap justify-between gap-4">
      <span>{labels.updated} · {updatedAt}</span>
      <a href={homeHref} class="hover:text-electric">{labels.backHome}</a>
    </footer>
  </article>

  <section class="bg-ink text-paper">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-6">{labels.ctaTitle}</h2>
      <a
        href="https://bbd.sh/contact?subject=citebeam"
        class="inline-block px-6 py-3 bg-electric text-ink hover:bg-paper transition-colors rounded font-mono font-bold text-sm"
      >
        {labels.ctaLabel} →
      </a>
    </div>
  </section>
</Base>
